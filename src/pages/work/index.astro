---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import Contact from '../../components/Contact.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work" description="Case studies from Ken Nichol's recent platform modernization and CI/CD engagements.">
  <section>
    <div class="wrap split">
      <div>
        <p class="eyebrow">Work</p>
        <h1>Case studies</h1>
        <p class="muted">
          Most of my work is under NDA, so clients are described by sector rather than named. Each study covers the
          situation, what I did, and what made it hard.
        </p>
      </div>
      <ul class="work-list">
        {
          work.map((entry) => (
            <li>
              <WorkCard entry={entry} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <Contact />
</Base>
