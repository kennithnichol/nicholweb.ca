---
import { site } from '../site';
import EmailLink from './EmailLink.astro';
---

<section class="contact" id="contact">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Have a platform that's become hard to change?</h2>
    </div>
    <div>
      <p class="lede">
        Tell me what you're working with and where it hurts. I'll reply with honest questions, and an honest answer
        about whether I'm the right person for it.
      </p>
      <div class="button-row">
        <EmailLink class="button" label="Email me" />
        <a href={site.links.linkedin}>LinkedIn</a>
      </div>
    </div>
  </div>
</section>
